Skip PAA root certificates that fail to parse instead of crashing startup.

The production Matter DCL serves at least one root certificate whose signature
algorithm encoding is rejected by cryptography's strict Rust ASN.1 parser
(ValueError: "error parsing asn1 value ... ExtraData"). fetch_dcl_certificates
only catches ClientError/TimeoutError, so this ValueError propagates out of
Server.start() before the websocket is mounted, leaving the service "active" but
never listening on :5580. Skip the offending cert and keep the rest.

--- a/matter_server/server/helpers/paa_certificates.py
+++ b/matter_server/server/helpers/paa_certificates.py
@@ -34,7 +34,13 @@ async def write_paa_root_cert(
             # via Slack.
             warnings.simplefilter("ignore", CryptographyDeprecationWarning)

-        cert = x509.load_pem_x509_certificate(pem_certificate.encode())
+        try:
+            cert = x509.load_pem_x509_certificate(pem_certificate.encode())
+        except ValueError as cert_err:
+            LOGGER.warning(
+                "Skipping unparseable PAA certificate '%s': %s", subject, cert_err
+            )
+            return False

     ski: x509.SubjectKeyIdentifier = cert.extensions.get_extension_for_class(
         x509.SubjectKeyIdentifier
