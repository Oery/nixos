#!/bin/sh

HYPR_SOCKET="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"

if [ -z "$HYPRLAND_INSTANCE_SIGNATURE" ]; then
    echo "Error: HYPRLAND_INSTANCE_SIGNATURE not set" >&2
    exit 1
fi

if [ ! -S "$HYPR_SOCKET" ]; then
    echo "Error: Socket not found at $HYPR_SOCKET" >&2
    exit 1
fi

socat -U - UNIX-CONNECT:"$HYPR_SOCKET" | while read -r line; do
    case "$line" in
        workspace*|workspacev2*)
            printf '%s\n' "$line"
            ;;
    esac
done
