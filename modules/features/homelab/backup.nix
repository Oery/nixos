# Nightly backup of homelab state from the NVMe to the media disk.
#
#   01:15  postgresqlBackup dumps the immich and dawarich databases
#   03:00  restic snapshots the paths below into /mnt/media/backups/restic
#
# Keeps 7 daily, 4 weekly and 6 monthly snapshots. The repository password is
# the restic-password agenix secret (also stored in the password manager).
# Media itself is not backed up: the arr stack can fetch it again.
#
# Restore example:
#   sudo restic -r /mnt/media/backups/restic \
#     --password-file /run/agenix/restic-password snapshots
_: {
  den.aspects.homelab-backup.nixos =
    { config, ... }:
    {
      services.postgresqlBackup = {
        enable = true;
        databases = [
          "immich"
          "dawarich"
        ];
      };

      services.restic.backups.homelab = {
        repository = "/mnt/media/backups/restic";
        passwordFile = config.age.secrets.restic-password.path;
        initialize = true;
        paths = [
          "/var/lib/immich" # photo library
          config.services.postgresqlBackup.location # database dumps
          "/var/lib/hass"
          "/var/lib/matter-server"
          "/var/lib/jellyfin"
          "/var/lib/dawarich"
          "/data/.state/nixarr"
          "/var/lib/discord-bot"
          # Decrypts the agenix secrets after a reinstall.
          "/etc/ssh/ssh_host_ed25519_key"
          "/etc/ssh/ssh_host_ed25519_key.pub"
        ];
        exclude = [
          # Regenerated by the services.
          "/var/lib/immich/thumbs"
          "/var/lib/immich/encoded-video"
          "/var/lib/jellyfin/transcodes"
        ];
        timerConfig = {
          OnCalendar = "03:00";
          Persistent = true;
        };
        pruneOpts = [
          "--keep-daily 7"
          "--keep-weekly 4"
          "--keep-monthly 6"
        ];
      };

      # Never write the repository onto the NVMe if the media disk is missing.
      systemd.services.restic-backups-homelab.unitConfig.RequiresMountsFor = [ "/mnt/media" ];
    };
}
