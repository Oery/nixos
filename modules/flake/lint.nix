# `nix fmt`                                  format every .nix file
# `nix build .#checks.x86_64-linux.lint`     nixfmt --check, deadnix, statix
#
# Skipped: flake.nix (generated by `nix run .#write-flake`) and the
# `_hardware.nix` files (generated by nixos-generate-config).
# deadnix also skips flake/defaults.nix, whose `__findFile` argument is used
# implicitly by the `<den/...>` angle-bracket syntax.
{ self, ... }:
{
  perSystem =
    { pkgs, ... }:
    let
      findSources = "find . -name '*.nix' ! -name _hardware.nix ! -path ./flake.nix";
    in
    {
      formatter = pkgs.writeShellApplication {
        name = "fmt";
        runtimeInputs = [ pkgs.nixfmt ];
        text = ''
          cd "$(git rev-parse --show-toplevel)"
          ${findSources} -print0 | xargs -0 nixfmt
        '';
      };

      checks.lint =
        pkgs.runCommandLocal "lint"
          {
            nativeBuildInputs = [
              pkgs.nixfmt
              pkgs.deadnix
              pkgs.statix
            ];
          }
          ''
            cd ${self}
            ${findSources} -print0 | xargs -0 nixfmt --check
            deadnix --fail --exclude modules/flake/defaults.nix flake.nix \
              $(find modules -name _hardware.nix) -- .
            statix check .
            touch $out
          '';
    };
}
